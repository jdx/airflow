        check = "./scripts/ci/prek/check_sdk_imports.py {{files}}"
    }
    // Name: Check schema defaults match server-side defaults
    ["check-schema-defaults"] {
        glob = List("airflow-core/src/airflow/serialization/schema.json", "airflow-core/src/airflow/serialization/serialized_objects.py")
        check = "./scripts/ci/prek/check_schema_defaults.py"
    }
    // Name: Check for problematic context manager class decorators
    ["check-contextmanager-class-decorators"] {
        glob = List("**/**test**.py")
        check = "./scripts/ci/prek/check_contextmanager_class_decorators.py {{files}}"
    }
}

