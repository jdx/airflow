local manual_steps = new Mapping<String, Step> {
    // Name: Upgrade important versions (manual)
    ["upgrade-important-versions"] {
        glob = #"(?x) ^\.pre-commit-config\.yaml$| ^\.github/\.pre-commit-config\.yaml$| ^scripts/ci/prek/update_installers_and_prek\.py$"#
        check = "./scripts/ci/prek/upgrade_important_versions.py"
    }
    // Name: Check translation completeness (manual)
    ["check-translations-completeness"] {
        check = "./dev/i18n/check_translations_completeness.py"
    }
    // Name: Update chart dependencies to latest (manual)
    ["update-chart-dependencies"] {
        glob = List(".pre-commit-config.yaml", "scripts/ci/prek/update_build_dependencies.py")
        check = "./scripts/ci/prek/update_chart_dependencies.py"
    }
    // Name: Compile ui assets (manual)
    ["compile-ui-assets"] {
        glob = List("airflow-core/src/airflow/ui/", "airflow-core/src/airflow/api_fastapi/auth/managers/simple/ui/")
        prefix = "mise x pipx:pnpm@9.7.1 --"
        check = "./scripts/ci/prek/compile_ui_assets.py"
    }
    // Name: Compile ui assets in dev mode (manual)
    ["compile-ui-assets-dev"] {
        glob = List("airflow-core/src/airflow/ui/", "airflow-core/src/airflow/api_fastapi/auth/managers/simple/ui/")
        prefix = "mise x pipx:pnpm@9.7.1 --"
        check = "./scripts/ci/prek/compile_ui_assets_dev.py"
    }
    // Original ID: mypy-dev
    // Name: Run mypy for dev (manual)
    ["mypy-dev-2"] {
        glob = List("**.py")
        check = "./scripts/ci/prek/mypy_folder.py dev"
    }
    // Original ID: mypy-airflow-core
    // Name: Run mypy for airflow-core (manual)
    ["mypy-airflow-core-2"] {
        glob = List("airflow-core/**.py")
        check = "./scripts/ci/prek/mypy_folder.py airflow-core"
    }
    // Original ID: mypy-providers
    // Name: Run mypy for providers (manual)
    ["mypy-providers-2"] {
        glob = List("**.py")
        check = "./scripts/ci/prek/mypy_folder.py providers"
    }
    // Original ID: mypy-task-sdk
    // Name: Run mypy for task-sdk (manual)
    ["mypy-task-sdk-2"] {
        glob = List("**.py")
        check = "./scripts/ci/prek/mypy_folder.py task-sdk"
    }
    // Original ID: mypy-devel-common
    // Name: Run mypy for devel-common (manual)
    ["mypy-devel-common-2"] {
        glob = List("**.py")
        check = "./scripts/ci/prek/mypy_folder.py devel-common"
    }
    // Original ID: mypy-airflow-ctl
    // Name: Run mypy for airflow-ctl (manual)
    ["mypy-airflow-ctl-2"] {
        glob = List("**.py")
        check = "./scripts/ci/prek/mypy_folder.py airflow-ctl"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps {
            ...linters
            ...local_hooks
            ...custom_steps
        }
    }
    ["pre-push"] {
        steps {
            ...linters
            ...local_hooks
            ...custom_steps
        }
    }
    ["check"] {
        steps {
            ...linters
            ...local_hooks
            ...custom_steps
            ...manual_steps
        }
    }
    ["fix"] {
        fix = true
        steps {
            ...linters
            ...local_hooks
            ...manual_steps
        }
    }
}
