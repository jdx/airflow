amends "../hk/pkl/Config.pkl"
import "../hk/pkl/Builtins.pkl"

// pre-commit default_language_version:
//   python: python3
//   node: 22.19.0
// 
// To set these versions with mise, run:
//   mise use python@3
//   mise use node@22.19.0

local linters = new Mapping<String, Step> {
    ["check-merge-conflict"] = Builtins.check_merge_conflict
    ["debug-statements"] = Builtins.python_debug_statements
    ["detect-private-key"] = (Builtins.detect_private_key) {
        exclude = List("providers/ssh/docs/connections/ssh.rst")
    }
    ["end-of-file-fixer"] = (Builtins.newlines) {
        exclude = #"(?x) ^airflow-core/docs/img/.*\.dot| ^airflow-core/docs/img/.*\.sha256| .*/dist/.*| LICENSES-ui\.txt$| .*/openapi-gen/.*"#
    }
    ["mixed-line-ending"] = Builtins.mixed_line_ending
    ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
        exclude = #"(?x) ^airflow-core/docs/img/.*\.dot$| ^dev/breeze/doc/images/output.*$| ^.*/openapi-gen/.*$| ^airflow-ctl/docs/images/.*\.svg$"#
    }
    ["yamllint"] = (Builtins.yamllint) {
        exclude = #"(?x) ^.*airflow\.template\.yaml$| ^.*init_git_sync\.template\.yaml$| ^chart/(?:templates|files)/.*\.yaml$| ^helm-tests/tests/chart_utils/keda.sh_scaledobjects\.yaml$| .*/v1.*\.yaml$| ^.*openapi.*\.yaml$| ^\.pre-commit-config\.yaml$| ^.*reproducible_build\.yaml$| ^.*pnpm-lock\.yaml$"#
        // types (AND): yaml
    }
}

local local_hooks = new Mapping<String, Step> {
    // Name: Check minimum Python version
    ["check-min-python-version"] {
        check = "./scripts/ci/prek/check_min_python_version.py {{files}}"
    }
    // Name: Check that TI and TIS have the same attributes
    ["check-taskinstance-tis-attrs"] {
        glob = List("airflow-core/src/airflow/models/taskinstance.py", "airflow-core/src/airflow/models/taskinstancehistory.py")
        check = "./scripts/ci/prek/check_ti_vs_tis_attributes.py"
    }
    // Name: Check and fix default value of default_deferrable
    ["check-deferrable-default"] {
        glob = #"^(providers/.*/)?airflow/.*/(sensors|operators)/.*\.py$"#
        check = "./scripts/ci/prek/check_deferrable_default.py"
    }
    // Name: Update dependencies for providers
    ["update-providers-dependencies"] {
        check = "./scripts/ci/prek/update_providers_dependencies.py"
        // always_run was true in pre-commit
    }
    // Name: Check shared distributions structure
    ["check-shared-distributions-structure"] {
        glob = List("shared/**")
        check = "./scripts/ci/prek/check_shared_distributions_structure.py"
    }
    // Name: Check shared distributions usage
    ["check-shared-distributions-usage"] {
        glob = "^shared/.*$|^.*/pyproject.toml$|^.*/_shared/.*$"
        check = "./scripts/ci/prek/check_shared_distributions_usage.py"
    }
    // Name: No templated field logic checks in operator __init__
    ["validate-operators-init"] {
        glob = #"^providers/.*/src/airflow/providers/.*/(operators|transfers|sensors)/.*\.py$"#
        check = "./scripts/ci/prek/validate_operators_init.py {{files}}"
    }
    // Name: Update providers build files
    ["update-providers-build-files"] {
        glob = #"""
(?x)
^providers/[^\/]*/src/airflow/providers/[^\/]*/__init__\.py$|
^providers/[^\/]*/[^\/]*/src/airflow/providers/[^\/]*/[^\/]*/__init__\.py$|
^providers/.*/pyproject\.toml$|
^providers/.*/provider\.yaml$|
^airflow_breeze/templates/PROVIDER__INIT__PY_TEMPLATE\.py\.jinja2$|
^airflow_breeze/templates/get_provider_info_TEMPLATE\.py\.jinja2$|
^airflow_breeze/templates/PROVIDER_README_TEMPLATE\.rst\.jinja2$
"""#
        check = "./scripts/ci/prek/update_providers_build_files.py {{files}}"
    }
    // Name: Check AIRFLOW_V imports in tests
    ["check-airflow-v-imports-in-tests"] {
        glob = #"^providers/.*/tests/.+\.py$"#
        check = "./scripts/ci/prek/check_airflow_v_imports_in_tests.py {{files}}"
    }
    // Name: Run 'ruff' for extremely fast Python linting
    ["ruff"] {
        exclude = List("airflow-core/tests/unit/dags/test_imports.py", "performance/tests/test_**.py")
        prefix = "mise x pipx:ruff@0.13.3 --"
        check = "ruff check --force-exclude {{files}}"
        // args from pre-commit: --fix
        // Consider adding args to check command
    }
    // Name: Run 'ruff format'
    ["ruff-format"] {
        exclude = List("airflow-core/tests/unit/dags/test_imports.py")
        check = "./scripts/ci/prek/ruff_format.py {{files}}"
    }
    // Name: Replace bad characters
    ["replace-bad-characters"] {
        exclude = #"(?x) ^clients/gen/go\.sh$| ^\.gitmodules$| ^airflow-core/src/airflow/ui/openapi-gen/| ^providers/edge3/src/airflow/providers/edge3/plugins/www/openapi-gen/| .*/dist/.*| \.go$| /go\.(mod|sum)$"#
        check = "./scripts/ci/prek/replace_bad_characters.py {{files}}"
    }
    // Name: Lint Dockerfile
    ["lint-dockerfile"] {
        glob = List("**/Dockerfile**")
        check = "./scripts/ci/prek/lint_dockerfile.py {{files}}"
    }
    // Name: Check airflow.kubernetes imports are not used
    ["check-airflow-k8s-not-used"] {
        glob = List("airflow-core/src/airflow/**.py")
        exclude = List("airflow-core/src/airflow/kubernetes/")
        check = #"./scripts/ci/prek/check_airflow_imports.py --pattern '^airflow\.kubernetes' --message "You should only import kubernetes code from `airflow.providers.cncf.kubernetes`." {{files}}"#
    }
    // Name: Check common.compat is used for OL deprecated classes
    ["check-common-compat-used-for-openlineage"] {
        glob = List("airflow-core/src/airflow/**.py")
        exclude = "(?x) ^airflow-core/src/airflow/openlineage/| ^airflow/providers/common/compat/openlineage/facet.py$"
        check = #"./scripts/ci/prek/check_airflow_imports.py --pattern '^openlineage\.client\.(facet|run)' --message "You should import from `airflow.providers.common.compat.openlineage.facet` instead." {{files}}"#
    }
    // Name: Sort airflow-bug-report provider list
    ["check-airflow-providers-bug-report-template"] {
        glob = List(".github/ISSUE_TEMPLATE/3-airflow_providers_bug_report.yml")
        check = "./scripts/ci/prek/check_airflow_bug_report_template.py {{files}}"
    }
    // Name: Check cncf.kubernetes imports used for executors only
    ["check-cncf-k8s-only-for-executors"] {
        glob = List("airflow-core/src/airflow/**.py")
        exclude = #"(?x) ^providers/.*/src/airflow/providers/| ^airflow-core/src/airflow/exceptions\.py$| ^airflow-core/src/airflow/models/renderedtifields\.py$| ^airflow-core/src/airflow/serialization/serialized_objects\.py$| ^airflow-core/src/airflow/serialization/serializers/kubernetes\.py$| ^airflow-core/src/airflow/utils/sqlalchemy\.py$"#
        check = #"./scripts/ci/prek/check_airflow_imports.py --pattern '^airflow\.providers\.cncf\.kubernetes' --message "Only few k8s executors exceptions are allowed to use `airflow.providers.cncf.kubernetes`." {{files}}"#
    }
    // Name: Update mounts in the local yml file
    ["update-local-yml-file"] {
        glob = List("dev/breeze/src/airflow_breeze/utils/docker_command_utils.py", "scripts/ci/docker_compose/local.yml")
        check = "./scripts/ci/prek/local_yml_mounts.py"
    }
    // Name: Check dependency of SQL providers
    ["check-sql-dependency-common-data-structure"] {
        glob = List("providers/**/src/airflow/providers/**/hooks/**.py")
        check = "./scripts/ci/prek/check_common_sql_dependency.py {{files}}"
    }
    // Name: Checks setup extra packages
    ["check-extra-packages-references"] {
        glob = List("airflow-core/docs/extra-packages-ref.rst", "hatch_build.py")
        check = "./scripts/ci/prek/check_extra_packages_ref.py"
    }
    // Name: Check order of extras in Dockerfile
    ["check-extras-order"] {
        glob = List("Dockerfile")
        check = "./scripts/ci/prek/check_order_dockerfile_extras.py"
    }
    // Name: Generate airflow diagrams
    ["generate-airflow-diagrams"] {
        glob = #"(?x) ^airflow-core/docs/.*/diagram_[^/]*\.py$| ^docs/images/.*\.py$| ^airflow-ctl/docs/images/diagrams/.*\.py$"#
        check = "./scripts/ci/prek/generate_airflow_diagrams.py {{files}}"
    }
    // Name: Generate volumes for docker compose
    ["generate-volumes-for-sources"] {
        glob = List("providers/**/provider.yaml")
        check = "./scripts/ci/prek/generate_volumes_for_sources.py"
    }
    // Name: Prevent deprecated sqlalchemy usage
    ["prevent-deprecated-sqlalchemy-usage"] {
        glob = #"(?x) ^airflow-ctl.*\.py$| ^airflow-core/src/airflow/models/.*\.py$| ^providers/fab/.*\.py$| ^task_sdk.*\.py$"#
        check = "./scripts/ci/prek/prevent_deprecated_sqlalchemy_usage.py {{files}}"
    }
    // Name: Updates supported versions in documentation
    ["update-supported-versions"] {
        glob = List("airflow-core/docs/installation/supported-versions.rst", "scripts/ci/prek/supported_versions.py", "README.md")
        check = "./scripts/ci/prek/supported_versions.py"
    }
    // Name: Check that the REVISION_HEADS_MAP is up-to-date
    ["check-revision-heads-map"] {
        glob = #"(?x) ^scripts/ci/prek/version_heads_map\.py$| ^airflow-core/src/airflow/migrations/versions/.*$|^airflow-core/src/airflow/migrations/versions| ^providers/fab/src/airflow/providers/fab/migrations/versions/.*$|^providers/fab/src/airflow/providers/fab/migrations/versions| ^airflow-core/src/airflow/utils/db\.py$| ^providers/fab/src/airflow/providers/fab/auth_manager/models/db\.py$"#
        check = "./scripts/ci/prek/check_revision_heads_map.py"
    }
    // Name: Update versions in docs
    ["update-version"] {
        glob = List("docs", "airflow-core/src/airflow/__init__.py", "**/pyproject.toml")
        check = "./scripts/ci/prek/update_versions.py"
    }
    // Name: Check for pydevd debug statements accidentally left
    ["check-pydevd-left-in-code"] {
        glob = List("**/.py")
        check = #"pydevd.*settrace\( {{files}}"#
    }
    // Name: Check pytest.mark.db_test use in providers
    ["check-pytest-mark-db-test-in-providers"] {
        glob = #"(?x) ^providers/airbyte/.*\.py$| ^providers/apache/beam/.*\.py$| ^providers/apache/flink/.*\.py$| ^providers/apache/iceberg/.*\.py$| ^providers/apache/kafka/.*\.py$| ^providers/apprise/.*\.py$| ^providers/arangodb/.*\.py$| ^providers/asana/.*\.py$| ^providers/atlassian/jira/.*\.py$| ^providers/cloudant/.*\.py$| ^providers/cohere/.*\.py$| ^providers/common/compat/.*\.py$| ^providers/common/messaging/.*\.py$| ^providers/datadog/.*\.py$| ^providers/dingding/.*\.py$| ^providers/discord/.*\.py$| ^providers/exasol/.*\.py$| ^providers/facebook/.*\.py$| ^providers/ftp/.*\.py$| ^providers/grpc/.*\.py$| ^providers/hashicorp/.*\.py$| ^providers/imap/.*\.py$| ^providers/influxdb/.*\.py$| ^providers/jdbc/.*\.py$| ^providers/jenkins/.*\.py$| ^providers/mongo/.*\.py$| ^providers/microsoft/psrp/.*\.py$| ^providers/microsoft/winrm/.*\.py$| ^providers/neo4j/.*\.py$| ^providers/odbc/.*\.py$| ^providers/openai/.*\.py$| ^providers/openfaas/.*\.py$| ^providers/opsgenie/.*\.py$| ^providers/oracle/.*\.py$| ^providers/pagerduty/.*\.py$| ^providers/pgvector/.*\.py$| ^providers/pinecone/.*\.py$| ^providers/postgres/.*\.py$| ^providers/presto/.*\.py$| ^providers/segment/.*\.py$| ^providers/sendgrid/.*\.py$| ^providers/singularity/.*\.py$| ^providers/slack/.*\.py$| ^providers/smtp/.*\.py$| ^providers/tableau/.*\.py$| ^providers/teradata/.*\.py$| ^providers/trino/.*\.py$| ^providers/vertica/.*\.py$| ^providers/yandex/.*\.py$| ^providers/zendesk/.*\.py$"#
        check = #"pytest\.mark\.db_test {{files}}"#
    }
    // Name: Verify no hard-coded version in example dags
    ["check-links-to-example-dags-do-not-use-hardcoded-versions"] {
        glob = List("providers/**/docs/**.rst")
        check = """
(?i) .*https://github.*/main/providers/.*/src/airflow/providers/.*/example_dags/| .*https://github.*/master/providers/.*/src/airflow/providers/.*/example_dags/
 {{files}}
"""
    }
    // Name: Don't use safe in templates
    ["check-safe-filter-usage-in-html"] {
        glob = List("**/.html")
        check = #"\|\s*safe {{files}}"#
    }
    // Name: No providers imports in core example DAGs
    ["check-no-providers-in-core-examples"] {
        glob = List("airflow-core/src/airflow/example_dags/**.py")
        check = #"^\s*from airflow\.providers.(?!standard.) {{files}}"#
    }
    // Name: Do not use DeprecationWarning in providers
    ["check-no-airflow-deprecation-in-providers"] {
        glob = List("providers/**/src/airflow/providers/**.py")
        check = #"^\s*DeprecationWarning* {{files}}"#
    }
    // Name: Don't use urlparse in code
    ["check-urlparse-usage-in-code"] {
        glob = List("**/.py")
        check = #"^\s*from urllib\.parse import ((\|, )(urlparse\|urlunparse))+$ {{files}}"#
    }
    // Name: Check NEW_SESSION is only used with @provide_session
    ["check-only-new-session-with-provide-session"] {
        glob = #"^airflow-core/src/airflow/.+\.py$"#
        exclude = List("airflow-core/src/airflow/serialization/pydantic/**")
        check = "./scripts/ci/prek/new_session_in_provide_session.py {{files}}"
    }
    // Name: Check for language that we do not accept as community
    ["check-for-inclusive-language"] {
        exclude = #"(?x) ^airflow-core/src/airflow/ui/src/i18n/config\.ts$| ^airflow-core/src/airflow/ui/openapi-gen/| ^airflow-core/src/airflow/ui/public/i18n/locales/de/README\.md$| ^airflow-core/src/airflow/cli/commands/local_commands/fastapi_api_command\.py$| ^airflow-core/src/airflow/config_templates/| ^airflow-core/src/airflow/models/baseoperator\.py$| ^airflow-core/src/airflow/operators/__init__\.py$| ^providers/common/sql/tests/provider_tests/common/sql/operators/test_sql_execute\.py$| ^providers/amazon/src/airflow/providers/amazon/aws/hooks/emr\.py$| ^providers/amazon/src/airflow/providers/amazon/aws/operators/emr\.py$| ^providers/apache/cassandra/src/airflow/providers/apache/cassandra/hooks/cassandra\.py$| ^providers/apache/hive/src/airflow/providers/apache/hive/operators/hive_stats\.py$| ^providers/apache/hive/src/airflow/providers/apache/hive/transfers/vertica_to_hive\.py$| ^providers/apache/spark/src/airflow/providers/apache/spark/decorators/| ^providers/apache/spark/src/airflow/providers/apache/spark/hooks/| ^providers/apache/spark/src/airflow/providers/apache/spark/operators/| ^providers/exasol/src/airflow/providers/exasol/hooks/exasol\.py$| ^providers/fab/src/airflow/providers/fab/auth_manager/security_manager/| ^providers/fab/src/airflow/providers/fab/www/static/| ^providers/fab/src/airflow/providers/fab/www/templates/| ^providers/google/src/airflow/providers/google/cloud/hooks/bigquery\.py$| ^providers/google/src/airflow/providers/google/cloud/operators/cloud_build\.py$| ^providers/google/src/airflow/providers/google/cloud/operators/dataproc\.py$| ^providers/google/src/airflow/providers/google/cloud/operators/mlengine\.py$| ^providers/keycloak/src/airflow/providers/keycloak/auth_manager/cli/definition.py| ^providers/microsoft/azure/src/airflow/providers/microsoft/azure/hooks/cosmos\.py$| ^providers/microsoft/winrm/src/airflow/providers/microsoft/winrm/hooks/winrm\.py$| ^airflow-core/docs/.*commits\.rst$| ^providers/microsoft/winrm/src/airflow/providers/microsoft/winrm/operators/winrm\.py$| ^providers/opsgenie/src/airflow/providers/opsgenie/hooks/opsgenie\.py$| ^providers/redis/src/airflow/providers/redis/provider\.yaml$| ^airflow-core/src/airflow/serialization/serialized_objects\.py$| ^airflow-core/src/airflow/api_fastapi/auth/managers/simple/ui/pnpm-lock\.yaml$| ^airflow-core/src/airflow/ui/pnpm-lock\.yaml$| ^airflow-core/src/airflow/utils/db\.py$| ^airflow-core/src/airflow/utils/trigger_rule\.py$| ^chart/values.schema\.json$| ^helm-tests/tests/chart_utils/helm_template_generator\.py$| ^helm-tests/tests/chart_utils/ingress-networking-v1beta1\.json$| ^dev/| ^devel-common/src/docs/README\.rst$| ^docs/apache-airflow-providers-amazon/secrets-backends/aws-ssm-parameter-store\.rst$| ^providers/apache/kafka/docs/connections/kafka\.rst$| ^providers/apache/hdfs/docs/connections\.rst$| ^providers/apache/spark/docs/decorators/pyspark\.rst$| ^providers/microsoft/azure/docs/connections/azure_cosmos\.rst$| ^providers/fab/docs/auth-manager/webserver-authentication\.rst$| ^providers/google/docs/operators/cloud/kubernetes_engine\.rst$| ^providers/cncf/kubernetes/docs/operators\.rst$| ^.*/conf\.py$| ^.*/conf_constants\.py$| ^.*/provider_conf\.py$| ^devel-common/src/sphinx_exts/removemarktransform\.py| ^devel-common/src/tests_common/test_utils/db\.py| ^airflow-core/newsfragments/41761.significant\.rst$| ^scripts/ci/prek/vendor_k8s_json_schema\.py$| ^scripts/ci/docker-compose/integration-keycloak\.yml$| ^scripts/ci/docker-compose/keycloak/keycloak-entrypoint\.sh$| ^airflow-core/tests/| ^providers/.*/tests/| ^\.pre-commit-config\.yaml$| ^.*CHANGELOG\.(rst|txt)$| ^.*changelog\.(rst|txt)$| ^.*commits\.(rst|txt)$| ^.*RELEASE_NOTES\.rst$| ^contributing-docs/03_contributors_quick_start\.rst$| ^.*\.(png|gif|jp[e]?g|svg|tgz|lock)$| git| ^airflow-core/newsfragments/43349\.significant\.rst$| ^airflow-core/newsfragments/41368\.significant\.rst$| .*/dist/.*| package-lock\.json$| ^providers/edge3/src/airflow/providers/edge3/plugins/www/pnpm-lock.yaml$"#
        check = #"""
(?ix) (black|white)[_-]?list| \bshe\b| \bhe\b| \bher\b| \bhis\b| \bmaster\b| \bslave\b| \bsanity\b| \bdummy\b
 {{files}}
"""#
    }
    // Name: Check BaseOperator and partial() arguments
    ["check-base-operator-partial-arguments"] {
        glob = #"^airflow-core/src/airflow/models/(?:base|mapped)operator\.py$"#
        check = "./scripts/ci/prek/check_base_operator_partial_arguments.py"
    }
    // Name: Sync model __init__ and decorator arguments
    ["check-init-decorator-arguments"] {
        glob = List("task-sdk/src/airflow/sdk/definitions/dag.py", "task-sdk/src/airflow/sdk/definitions/decorators/task_group.py")
        check = "./scripts/ci/prek/check_init_decorator_arguments.py"
    }
    // Name: Sync template context variable refs
    ["check-template-context-variable-in-sync"] {
        glob = List("airflow-core/src/airflow/models/taskinstance.py", "task-sdk/src/airflow/sdk/definitions/context.py", "airflow-core/docs/templates-ref.rst")
        check = "./scripts/ci/prek/check_template_context_variable_in_sync.py {{files}}"
    }
    // Name: Check BaseOperator core imports
    ["check-base-operator-usage"] {
        glob = List("**/.py")
        exclude = "(?x) ^airflow-core/src/airflow/decorators/.*$| ^airflow-core/src/airflow/hooks/.*$| ^airflow-core/src/airflow/operators/.*$| ^providers/.*$"
        check = #"from airflow\.models import.* BaseOperator\b {{files}}"#
    }
    // Original ID: check-base-operator-usage
    // Name: Check BaseOperatorLink core imports
    ["check-base-operator-usage-2"] {
        glob = List("**/.py")
        exclude = "(?x) ^airflow-core/src/airflow/decorators/.*$| ^airflow-core/src/airflow/hooks/.*$| ^airflow-core/src/airflow/operators/.*$| ^providers/.*/src/airflow/providers/.*$| ^providers/.*/src/airflow/providers/standard/sensors/.*$"
        check = #"^\s*from airflow\.models\.baseoperatorlink import BaseOperatorLink\b {{files}}"#
    }
    // Original ID: check-base-operator-usage
    // Name: Check BaseOperator other imports
    ["check-base-operator-usage-3"] {
        glob = #"(?x) ^providers/.*/src/airflow/providers/.*\.py$"#
        exclude = List("providers/standard/**/**.py")
        check = #"from airflow\.models\.baseoperator import.* BaseOperator {{files}}"#
    }
    // Name: Check providers import hook lineage code from compat
    ["check-get-lineage-collector-providers"] {
        glob = List("providers/**/src/airflow/providers/**.py")
        exclude = List("providers/common/compat/src/airflow/providers/common/compat/**.py")
        check = #"./scripts/ci/prek/check_airflow_imports.py --pattern '^airflow\.lineage\.hook' --message "Only TYPE_CHECKING imports from `airflow.lineage.hook` are allowed in providers." --only_top_level {{files}}"#
    }
    // Name: Check @task decorator implements custom_operator_name
    ["check-decorated-operator-implements-custom-name"] {
        glob = List("airflow-core/src/airflow/**.py")
        check = "./scripts/ci/prek/decorator_operator_implements_custom_name.py {{files}}"
    }
    // Name: Verify usage of Airflow deprecation classes in core
    ["check-core-deprecation-classes"] {
        glob = List("**/.py")
        exclude = List("airflow-core/src/airflow/configuration.py", "airflow-core/tests/**", "providers/**/src/airflow/providers/", "scripts/in_container/verify_providers.py", "providers/**/tests/**", "devel-common/")
        check = "category=DeprecationWarning|category=PendingDeprecationWarning {{files}}"
    }
    // Name: Check session util imports
    ["check-provide-create-sessions-imports"] {
        glob = List("**/.py")
        check = #"from airflow\.utils\.db import.* (NEW_SESSION|provide_session|create_session) {{files}}"#
    }
    // Name: Make sure LoggingMixin is not used alone
    ["check-incorrect-use-of-LoggingMixin"] {
        glob = List("**/.py")
        check = #"LoggingMixin\(\) {{files}}"#
    }
    // Name: start_date not in default_args
    ["check-start-date-not-used-in-defaults"] {
        glob = #"\.*example_dags.*\.py$"#
        check = #"default_args\s*=\s*{\s*("|')start_date("|')|("|')start_date("|'): {{files}}"#
    }
    // Name: Check if licenses are OK for Apache
    ["check-apache-license-rat"] {
        glob = List("LICENSE")
        check = "./scripts/ci/prek/check_license.py"
    }
    // Name: Check if aiobotocore is an optional dependency only
    ["check-aiobotocore-optional"] {
        glob = List("providers/**/provider.yaml")
        check = "./scripts/ci/prek/check_aiobotocore_optional.py {{files}}"
    }
    // Name: Checks for Boring Cyborg configuration consistency
    ["check-boring-cyborg-configuration"] {
        check = "./scripts/ci/prek/boring_cyborg.py"
    }
    // Name: Sort INTHEWILD.md alphabetically
    ["update-in-the-wild-to-be-sorted"] {
        glob = List(".pre-commit-config.yaml", "INTHEWILD.md")
